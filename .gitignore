# Byte-compiled / cache
__pycache__/
*.py[cod]

# Local virtualenv (recreate: python3 -m venv .venv && .venv/bin/pip install gmpy2 pyyaml)
.venv/

# Generated run artifacts from search comparisons and swarm workers
snapshots/search_compare/run-*/
logs/*.log

# Scratch directories a snapshot restore leaves behind if its process is killed mid-boot
hyge-*-restore-*/
