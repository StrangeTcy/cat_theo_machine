+class RelationContractLookupMatchingTest(M.Edge):
+    """Read-side bridge: a contract with declared arity and every required
+    ExtensionalAt position is eligible, and both source-bearing records
+    are preserved in delivery order.
+    """
+
+    def __init__(self, graph):
+        from . import research as Rmod
+
+        empty = M.EmptyList
+        records, name, arity, positions, rec_a, rec_b = _relation_contract_records()
+        selected = Rmod.RelationContractsFor(records, name)()
+        meets = Rmod.RelationContractMeets(records, name, arity, positions)()
+        verdict = M.Head(meets)()
+        support = M.Head(M.Tail(meets)())()
+        expected = M.Pair(rec_a, M.Pair(rec_b, empty))
+
+        self.result = M.truth_value
+        if M.Compare(selected, expected)() is M.false_value:
+            self.result = M.false_value
+        elif verdict is not M.truth_value:
+            self.result = M.false_value
+        elif M.Compare(support, expected)() is M.false_value:
+            self.result = M.false_value
+        super().__init__(inputs=empty, results=M.Pair(self.result, empty))
+
+    def __call__(self):
+        return self.result
+
