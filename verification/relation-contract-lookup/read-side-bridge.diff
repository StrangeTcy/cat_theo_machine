+        var = M.Pair(M.VarTag, M.Pair(M.Char("p"), empty))
+
+        # (a) a non-record entry in the chain
+        bad_chain = M.Pair(M.Char("divides"), empty)
+        sel_a = Rmod.RelationContractsFor(bad_chain, name)()
+        meets_a = Rmod.RelationContractMeets(bad_chain, name, arity, M.Pair(M.one, empty))()
+
+        # (b) a variable in an atom slot, built raw past the constructor wall
+        raw_b = M.Pair(
+            Lmod.RelationContractsLabel,
+            M.Pair(
+                M.Pair(Lmod.ExtensionalAtLabel, M.Pair(name, M.Pair(var, empty))),
+                M.Pair(M.Char("s"), M.Pair(Lmod.ContractFactLabel, empty)),
+            ),
+        )
+        sel_b = Rmod.RelationContractsFor(M.Pair(raw_b, empty), name)()
+        meets_b = Rmod.RelationContractMeets(M.Pair(raw_b, empty), name, arity, M.Pair(M.one, empty))()
+
+        # (c) a variable nested inside the source
+        raw_c = M.Pair(
+            Lmod.RelationContractsLabel,
+            M.Pair(
+                M.Pair(Lmod.RelationArityLabel, M.Pair(name, M.Pair(M.two, empty))),
+                M.Pair(
+                    M.Pair(M.VarTag, M.Pair(M.Char("src"), empty)),
+                    M.Pair(Lmod.ContractFactLabel, empty),
