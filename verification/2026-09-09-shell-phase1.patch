+#!/bin/sh
+# D11-SHELL-ENG Phase 0 — A/B/C baseline reproduction on a pinned tree.
+# Usage: sh 2026-09-09-shell-phase0-probes.sh <repo-root> <out-dir>
+# Each probe runs in its own fresh process; the caller supplies a FRESH
+# worktree per probe (probe-isolation rule adopted by F-PROVER, 5237605).
+# Pinned base: arena/01a06542 @ bfd4bd2 (verified live at Phase 0 time).
+set -e
+ROOT="$1"
+OUT="$2"
+mkdir -p "$OUT"
+run_probe() {
+  name="$1"; sentence="$2"
+  printf 'research mode on\nload theorem packs\n%s\ngoodbye\n' "$sentence" \
+    | env PYTHONPATH="$PKG_PARENT" timeout 900 python3 -m cat_theo_machine.main \
+    > "$OUT/probe-$name-raw.log" 2>&1
+  grep -E "parsed goal|FAILED|residual" "$OUT/probe-$name-raw.log" || true
+}
+PKG_PARENT="$(cd "$ROOT/.." && pwd)"
+# the worktree directory itself is the package; import name fixed by a
+# sibling symlink when the worktree is not named cat_theo_machine:
+if [ ! -d "$PKG_PARENT/cat_theo_machine" ]; then
+  ln -sfn "$(cd "$ROOT" && pwd)" "$PKG_PARENT/cat_theo_machine"
+fi
+run_probe A "prove that a + a = a + a"
+run_probe B "prove that a + b = b + a has no solutions in positive integers"
+run_probe C "prove that for all n > 1 a + a = a + a"
