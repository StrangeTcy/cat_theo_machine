+
+def _contract_atoms_well_formed(atoms):
+    from .proof import ContainsVar
+
+    walk = atoms
+    while IdentityCompare(walk, EmptyList)() is M.false_value:
+        if M.IsPair(walk)() is M.false_value:
+            return M.false_value
+        atom = Head(walk)()
+        if M.IsPair(atom)() is M.false_value:
+            return M.false_value
+        label = Head(atom)()
+        payload = Tail(atom)()  # Pair(name, Pair(slot, EmptyList))
+        if M.IsPair(payload)() is M.false_value:
+            return M.false_value
+        name = Head(payload)()
+        slot_pair = Tail(payload)()  # Pair(slot, EmptyList)
+        if M.IsPair(slot_pair)() is M.false_value:
+            return M.false_value
+        slot = Head(slot_pair)()
+        if IdentityCompare(Tail(slot_pair)(), EmptyList)() is M.false_value:
+            return M.false_value
+        if ContainsVar(name)() is M.truth_value or ContainsVar(slot)() is M.truth_value:
+            return M.false_value
