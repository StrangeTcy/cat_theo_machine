+        rm = Rmod.RelationContractRecordRemove(records, name, M.Char("s"))()
+        Rmod.RelationContractsFor(_contract_add_records(rm), name)()
+
+        second = Rmod.attempt_goal(graph, start, goal, rules)
+        second_open = M.false_value
+        if Rmod.ForwardSearchClosed(second)() is M.false_value:
+            second_open = M.truth_value
+
+        self.result = M.truth_value
+        if first_open is not M.truth_value:
+            self.result = M.false_value
+        elif second_open is not M.truth_value:
