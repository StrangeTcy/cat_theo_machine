+class RelationContractWriteCheckpointRoundtripTest(M.Edge):
+    """Write bridge: records survive a cold codec save/restore, and query
+    and selective remove keep working on the restored chain.
+    """
+
+    def __init__(self, graph):
+        from . import research as Rmod
+
+        empty = M.EmptyList
+        divides = M.Char("divides")
+        nand = M.Char("nand")
+        arity = M.two
+        positions = M.Pair(M.one, M.Pair(M.two, empty))
+        atoms = _contract_atoms_for(divides, arity, positions)
+        nand_atoms = _contract_atoms_for(nand, arity, M.Pair(M.one, empty))
+        src = M.Char("session-A")
+        out = Rmod.RelationContractRecordAdd(empty, atoms, src)()
+        records = _contract_add_records(out)
+        out2 = Rmod.RelationContractRecordAdd(records, nand_atoms, M.Char("session-B"))()
+        records = _contract_add_records(out2)
+
+        namespace = dict(vars(M))
+        namespace.update(vars(Lmod))
+        namespace.update(vars(Gmod))
+        codec = SnapshotCodec(namespace)
+        restored = codec.load_snapshot(codec.capture_objects({"records": records})).roots["records"]
+
+        first_record = M.Head(restored)()
+        restored_src = Gmod.RelationContractsSource(first_record)()
+        restored_prov = Gmod.RelationContractsProvenance(first_record)()
+        sel = Rmod.RelationContractsFor(restored, divides)()
+        meets = Rmod.RelationContractMeets(restored, divides, arity, positions)()
+        verdict = M.Head(meets)()
+        rm = Rmod.RelationContractRecordRemove(restored, divides, src)()
+        updated = _contract_add_records(rm)
+        divides_after = Rmod.RelationContractsFor(updated, divides)()
+        nand_meets = Rmod.RelationContractMeets(updated, nand, arity, M.Pair(M.one, empty))()
+        nand_verdict = M.Head(nand_meets)()
+
+        self.result = M.truth_value
+        if M.IdentityCompare(restored, records)() is not M.false_value:
+            self.result = M.false_value
+        elif M.Compare(restored, records)() is M.false_value:
+            self.result = M.false_value
+        elif M.Compare(restored_src, src)() is M.false_value:
+            self.result = M.false_value
+        elif M.Compare(restored_prov, Lmod.ContractFactLabel)() is M.false_value:
+            self.result = M.false_value
+        elif _chain_length(sel) != 1:
+            self.result = M.false_value
+        elif verdict is not M.truth_value:
+            self.result = M.false_value
+        elif _contract_report_status(_contract_add_report(rm)) is not M.truth_value:
+            self.result = M.false_value
+        elif M.IdentityCompare(divides_after, empty)() is M.false_value:
+            self.result = M.false_value
+        elif nand_verdict is not M.truth_value:
+            self.result = M.false_value
+        super().__init__(inputs=empty, results=M.Pair(self.result, empty))
+
+    def __call__(self):
+        return self.result
