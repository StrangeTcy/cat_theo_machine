+        goal = M.Pair(BoardSumFact(M.Char("x"), M.two)(), empty)
+        rules = empty
+
+        first = Rmod.attempt_goal(graph, start, goal, rules)
+        first_open = M.false_value
+        if Rmod.ForwardSearchClosed(first)() is M.false_value:
+            first_open = M.truth_value
+
+        before_nodes = graph.nodes
+        before_rules = graph.all_rules
+        before_provenance = graph.provenance_map
+        before_policy = graph.generator_policy
+
+        out = Rmod.RelationContractRecordAdd(empty, atoms, M.Char("s"))()
