+        selected = Rmod.RelationContractsFor(records, name)()
+        meets = Rmod.RelationContractMeets(records, name, arity, positions)()
+        if _chain_length(selected) != 1 or M.Compare(selected, records)() is M.false_value:
+            self.result = M.false_value
+        elif M.Head(meets)() is not M.truth_value:
+            self.result = M.false_value
+        elif M.Compare(M.Head(M.Tail(meets)())(), records)() is M.false_value:
+            self.result = M.false_value
+        elif M.Head(Rmod.RelationContractMeets(records, name, arity, M.Pair(M.one, M.Pair(M.three, empty)))())() is not M.false_value:
+            self.result = M.false_value
+        elif M.IdentityCompare(Rmod.RelationContractsFor(records, other)(), empty)() is M.false_value:
+            self.result = M.false_value
+        elif M.Head(Rmod.RelationContractMeets(records, other, arity, M.Pair(M.one, empty))())() is not M.false_value:
+            self.result = M.false_value
+
+        # (4) reordered and duplicated atoms, write-produced
+        arity_atom = Gmod.RelationContractArity(name, arity)()
+        ext1 = Gmod.RelationContractExtensionalAt(name, M.one)()
+        ext2 = Gmod.RelationContractExtensionalAt(name, M.two)()
+        dup_atoms = M.Pair(ext2, M.Pair(ext1, M.Pair(arity_atom, M.Pair(arity_atom, empty))))
+        out4 = Rmod.RelationContractRecordAdd(empty, dup_atoms, M.Char("s2"))()
+        rec4 = _contract_add_records(out4)
+        out4b = Rmod.RelationContractRecordAdd(rec4, dup_atoms, M.Char("s2"))()
+        rec4b = _contract_add_records(out4b)
+        if M.Compare(rec4b, rec4)() is M.false_value:
+            self.result = M.false_value
+        elif _chain_length(Rmod.RelationContractsFor(rec4, name)()) != 1:
+            self.result = M.false_value
+        elif M.Head(Rmod.RelationContractMeets(rec4, name, arity, positions)())() is not M.truth_value:
+            self.result = M.false_value
+
+        # (5) variable-bearing store: write refuses, read refuses
+        var = M.Pair(M.VarTag, M.Pair(M.Char("p"), empty))
+        var_atom = M.Pair(Lmod.ExtensionalAtLabel, M.Pair(name, M.Pair(var, empty)))
+        out5 = Rmod.RelationContractRecordAdd(records, M.Pair(var_atom, empty), M.Char("s3"))()
+        if _contract_report_status(_contract_add_report(out5)) is not M.false_value:
+            self.result = M.false_value
+        elif M.Compare(_contract_add_records(out5), records)() is M.false_value:
+            self.result = M.false_value
+        malformed = M.Pair(
+            Lmod.RelationContractsLabel,
+            M.Pair(
+                M.Pair(Lmod.ExtensionalAtLabel, M.Pair(name, M.Pair(var, empty))),
+                M.Pair(M.Char("s"), M.Pair(Lmod.ContractFactLabel, empty)),
+            ),
+        )
+        if M.IdentityCompare(Rmod.RelationContractsFor(M.Pair(malformed, records), name)(), empty)() is M.false_value:
+            self.result = M.false_value
+
+        # (6) conflicting declarations: write refuses, read refuses hand-built
+        proposed = _contract_atoms_for(name, M.three, M.Pair(M.two, empty))
+        out6 = Rmod.RelationContractRecordAdd(records, proposed, M.Char("s4"))()
+        if _contract_report_status(_contract_add_report(out6)) is not M.false_value:
+            self.result = M.false_value
+        rec_conf_a = Gmod.RelationContracts(
+            M.Pair(Gmod.RelationContractArity(name, M.two)(), M.Pair(ext1, empty)),
+            M.Char("s5"),
+        )()
+        rec_conf_b = Gmod.RelationContracts(
+            M.Pair(Gmod.RelationContractArity(name, M.three)(), M.Pair(ext2, empty)),
+            M.Char("s6"),
+        )()
+        conf_chain = M.Pair(rec_conf_a, M.Pair(rec_conf_b, empty))
+        if _chain_length(Rmod.RelationContractsFor(conf_chain, name)()) != 2:
+            self.result = M.false_value
+        elif M.Head(Rmod.RelationContractMeets(conf_chain, name, arity, positions)())() is not M.false_value:
+            self.result = M.false_value
+
+        # (7) source equality by value, write-produced
+        out7 = Rmod.RelationContractRecordAdd(records, atoms, M.Char("s1"))()
+        rec7 = _contract_add_records(out7)
+        if M.Compare(rec7, records)() is M.false_value:
+            self.result = M.false_value
+        out7b = Rmod.RelationContractRecordAdd(records, atoms, M.Char("s-other"))()
+        rec7b = _contract_add_records(out7b)
+        if _chain_length(Rmod.RelationContractsFor(rec7b, name)()) != 2:
+            self.result = M.false_value
+
+        # (8) cold codec round-trip of write-produced records
+        namespace = dict(vars(M))
+        namespace.update(vars(Lmod))
+        namespace.update(vars(Gmod))
+        codec = SnapshotCodec(namespace)
+        restored = codec.load_snapshot(codec.capture_objects({"records": records})).roots["records"]
+        if M.Compare(restored, records)() is M.false_value:
+            self.result = M.false_value
+        elif _chain_length(Rmod.RelationContractsFor(restored, name)()) != 1:
+            self.result = M.false_value
+        elif M.Head(Rmod.RelationContractMeets(restored, name, arity, positions)())() is not M.truth_value:
+            self.result = M.false_value
+
+        # (9) non-activation: lookups leave the graph untouched
+        before_nodes = graph.nodes
+        Rmod.RelationContractsFor(records, name)()
+        Rmod.RelationContractMeets(records, name, arity, positions)()
+        if M.Compare(before_nodes, graph.nodes)() is not M.truth_value:
+            self.result = M.false_value
+
+        super().__init__(inputs=empty, results=M.Pair(self.result, empty))
+
+    def __call__(self):
+        return self.result
+
