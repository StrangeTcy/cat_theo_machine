+def _contract_atoms_for(relation_name, arity, positions):
+    """Ground contract atoms for one relation: arity plus one ExtensionalAt
+    per position, in that order.
+    """
+    empty = M.EmptyList
+    pieces = [Gmod.RelationContractArity(relation_name, arity)()]
+    walk = positions
+    while M.IdentityCompare(walk, empty)() is M.false_value:
+        pieces.append(
+            Gmod.RelationContractExtensionalAt(relation_name, M.Head(walk)())()
+        )
+        walk = M.Tail(walk)()
+    acc = empty
+    for piece in reversed(pieces):
+        acc = M.Pair(piece, acc)
+    return acc
+
+
+def _contract_records_trie(records, registry, start=None):
+    """Project a retained record chain into a knowledge trie by the existing
+    RelationContracts insertion path.
+    """
+    empty = M.EmptyList
+    trie = M.EmptyTree if start is None else start
+    walk = records
+    while M.IdentityCompare(walk, empty)() is M.false_value:
+        trie = Gmod.RelationContractsInsert(trie, M.Head(walk)(), registry)()
+        walk = M.Tail(walk)()
+    return trie
+
+
+def _chain_length(chain):
+    empty = M.EmptyList
+    n = 0
+    while M.IdentityCompare(chain, empty)() is M.false_value:
+        n += 1
+        chain = M.Tail(chain)()
+    return n
+
+
+def _contract_add_records(result):
+    return M.Head(result)()
+
+
+def _contract_add_report(result):
+    return M.Head(M.Tail(result)())()
+
+
+def _contract_report_status(report):
+    return M.Head(report)()
+
+
+def _contract_report_source(report):
+    return M.Head(M.Tail(report)())()
+
+
+def _contract_report_atoms(report):
+    return M.Head(M.Tail(M.Tail(report)())())()
+
+
+def _contract_report_provenance(report):
+    return M.Head(M.Tail(M.Tail(M.Tail(report)())())())()
+
