+class RelationContractsFor(Edge):
+    """Read-side contract bridge: select source-bearing records about one relation.
+
+    Walks `records` (a chain of RelationContracts records) and returns the
+    chain of records that carry at least one contract atom (arity or
+    extensional-at) whose name is value-equal to `relation`. The selection
+    deduplicates records by machine value, so duplicate delivery yields no
+    duplicate source credit. Malformed records, variable-bearing atoms, and
+    a variable request refuse: the selection is EmptyList. No mutation.
+    """
+
+    def __init__(self, records, relation):
+        self.result = self._select(records, relation)
+        super().__init__(
+            inputs=M.Pair(records, M.Pair(relation, EmptyList)),
+            results=self.result,
+        )
+
+    def _select(self, records, relation):
+        from .proof import ContainsVar
+
+        if ContainsVar(relation)() is M.truth_value:
+            return EmptyList
+        matches = []
+        malformed = False
+        walk = records
+        while IdentityCompare(walk, EmptyList)() is M.false_value:
+            if M.IsPair(walk)() is M.false_value:
+                malformed = True
+                break
+            record = Head(walk)()
+            if _contract_record_well_formed(record) is M.false_value:
+                malformed = True
+                break
+            if self._record_declares(record, relation):
+                if not _contract_value_in(matches, record):
+                    matches.append(record)
+            walk = Tail(walk)()
+        if malformed:
+            return EmptyList
+        return _contract_chain_of(matches)
+
+    def _record_declares(self, record, relation):
+        atoms = Head(Tail(record)())()
+        walk = atoms
+        while IdentityCompare(walk, EmptyList)() is M.false_value:
+            atom = Head(walk)()
+            if M.Compare(Head(Tail(atom)())(), relation)() is M.truth_value:
+                return True
+            walk = Tail(walk)()
+        return False
+
+    def __call__(self):
+        return self.result
+
+
+class RelationContractMeets(Edge):
+    """Read-side eligibility: does the record set carry the contract for
+    `relation` with the requested `arity` and every required position?
+
+    Result: Pair(verdict, Pair(supporting_records, EmptyList)). Eligible
+    (truth_value) iff some well-formed record declares `arity` for
+    `relation` and every position in `required_positions` has an
+    ExtensionalAt atom for `relation`. Refuses (false_value, empty
+    support) on malformed records, variable-bearing atoms, variable
+    requests, and conflicting arity declarations. No mutation.
+    """
+
+    def __init__(self, records, relation, arity, required_positions):
+        self.result = self._meets(records, relation, arity, required_positions)
+        super().__init__(
+            inputs=M.Pair(
+                records,
+                M.Pair(relation, M.Pair(arity, M.Pair(required_positions, EmptyList))),
+            ),
+            results=self.result,
+        )
+
+    def _meets(self, records, relation, arity, required_positions):
+        from .proof import ContainsVar
+
+        refuse = M.Pair(M.false_value, M.Pair(EmptyList, EmptyList))
+        if (
+            ContainsVar(relation)() is M.truth_value
+            or ContainsVar(arity)() is M.truth_value
+            or ContainsVar(required_positions)() is M.truth_value
+        ):
+            return refuse
+        declared_arities = []
+        covered_positions = []
+        supporting = []
+        malformed = False
+        walk = records
+        while IdentityCompare(walk, EmptyList)() is M.false_value:
+            if M.IsPair(walk)() is M.false_value:
+                malformed = True
+                break
+            record = Head(walk)()
+            if _contract_record_well_formed(record) is M.false_value:
+                malformed = True
+                break
+            about = self._record_atoms_about(record, relation)
+            if about:
+                if not _contract_value_in(supporting, record):
+                    supporting.append(record)
+                for atom in about:
+                    label = Head(atom)()
+                    slot = Head(Tail(Tail(atom)())())()
+                    if M.Compare(label, Lmod.RelationArityLabel)() is M.truth_value:
+                        if not _contract_value_in(declared_arities, slot):
+                            declared_arities.append(slot)
+                    else:
+                        if not _contract_value_in(covered_positions, slot):
+                            covered_positions.append(slot)
+            walk = Tail(walk)()
+        if malformed:
+            return refuse
+        if len(declared_arities) > 1:
+            return refuse
+        if not _contract_value_in(declared_arities, arity):
+            return refuse
+        position_walk = required_positions
+        while IdentityCompare(position_walk, EmptyList)() is M.false_value:
+            position = Head(position_walk)()
+            if not _contract_value_in(covered_positions, position):
+                return refuse
+            position_walk = Tail(position_walk)()
+        support_chain = _contract_chain_of(supporting)
+        return M.Pair(M.truth_value, M.Pair(support_chain, EmptyList))
+
+    def _record_atoms_about(self, record, relation):
+        atoms = Head(Tail(record)())()
+        about = []
+        walk = atoms
+        while IdentityCompare(walk, EmptyList)() is M.false_value:
+            atom = Head(walk)()
+            if M.Compare(Head(Tail(atom)())(), relation)() is M.truth_value:
+                about.append(atom)
+            walk = Tail(walk)()
+        return about
+
+    def __call__(self):
+        return self.result
+
+
+def _contract_record_declares(record, relation):
+    """True when any contract atom in `record` names `relation` by value."""
+    atoms = Head(Tail(record)())()
+    walk = atoms
+    while IdentityCompare(walk, EmptyList)() is M.false_value:
+        atom = Head(walk)()
+        if M.Compare(Head(Tail(atom)())(), relation)() is M.truth_value:
+            return True
+        walk = Tail(walk)()
+    return False
+
+
+def _contract_report(status, source, atoms):
+    """Pair(status, Pair(source, Pair(atoms, Pair(ContractFactLabel, EmptyList))))."""
+    return M.Pair(
+        status,
+        M.Pair(source, M.Pair(atoms, M.Pair(Lmod.ContractFactLabel, EmptyList))),
+    )
+
+
+class RelationContractRecordAdd(Edge):
+    """Write-side contract bridge: add one source-bearing contract record.
+
+    Result: Pair(updated_records, Pair(report, EmptyList)) where
+    report = Pair(status, Pair(source, Pair(atoms, Pair(ContractFactLabel,
+    EmptyList)))). status is truth_value when the record is retained
+    (freshly appended, or already present by machine value -- idempotent)
+    and false_value on refusal. Refusals return `records` unchanged and
+    fire on: a variable source, malformed or variable-bearing atoms, or a
+    conflicting arity for one relation (new atoms disagreeing with a
+    retained arity, or with each other). The record is built through the
+    existing RelationContracts constructor, so its ContractFactLabel
+    provenance and full shape are preserved. No trie, rule pool, policy,
+    planner alternative, or FireAny entry is touched: the edge is pure over
+    the retained record chain.
+    """
+
+    def __init__(self, records, atoms, source):
+        self.result = self._add(records, atoms, source)
+        super().__init__(
+            inputs=M.Pair(records, M.Pair(atoms, M.Pair(source, EmptyList))),
+            results=self.result,
+        )
+
+    def _add(self, records, atoms, source):
+        from .proof import ContainsVar
+        from . import graph as Gmod
+
+        refuse = M.Pair(
+            records,
+            M.Pair(_contract_report(M.false_value, source, atoms), EmptyList),
+        )
+        if ContainsVar(source)() is M.truth_value:
+            return refuse
+        if _contract_atoms_well_formed(atoms) is M.false_value:
+            return refuse
+        existing = []
+        walk = records
+        while IdentityCompare(walk, EmptyList)() is M.false_value:
+            if M.IsPair(walk)() is M.false_value:
+                return refuse
+            record = Head(walk)()
+            if _contract_record_well_formed(record) is M.false_value:
+                return refuse
+            existing.append(record)
+            walk = Tail(walk)()
+        if self._arity_conflict(atoms, existing):
+            return refuse
+        record = Gmod.RelationContracts(atoms, source)()
+        if _contract_value_in(existing, record):
+            # Idempotent: the record is already retained by value.
+            return M.Pair(
+                records,
+                M.Pair(_contract_report(M.truth_value, source, atoms), EmptyList),
+            )
+        updated = _contract_chain_of(existing + [record])
+        return M.Pair(
+            updated,
+            M.Pair(_contract_report(M.truth_value, source, atoms), EmptyList),
+        )
+
+    def _arity_conflict(self, atoms, existing_records):
+        new_arities = self._arity_atoms(atoms)
+        old_arities = []
+        for record in existing_records:
+            old_arities.extend(self._arity_atoms(Head(Tail(record)())()))
+        for new_atom in new_arities:
+            new_name = Head(Tail(new_atom)())()
+            new_slot = Head(Tail(Tail(new_atom)())())()
+            for other in new_arities + old_arities:
+                other_name = Head(Tail(other)())()
+                other_slot = Head(Tail(Tail(other)())())()
+                if M.Compare(new_name, other_name)() is M.truth_value:
+                    if M.Compare(new_slot, other_slot)() is M.false_value:
+                        return True
+        return False
+
+    def _arity_atoms(self, atoms):
+        result = []
+        walk = atoms
+        while IdentityCompare(walk, EmptyList)() is M.false_value:
+            atom = Head(walk)()
+            if M.Compare(Head(atom)(), Lmod.RelationArityLabel)() is M.truth_value:
+                result.append(atom)
+            walk = Tail(walk)()
+        return result
+
+    def __call__(self):
+        return self.result
+
+
+class RelationContractRecordRemove(Edge):
+    """Write-side contract bridge: remove one selected contract record.
+
+    Selection is by machine value: the record whose source is value-equal
+    to `source` and that declares `relation`. Absent or ambiguous targets
+    refuse with `records` unchanged (no mutation). Result:
+    Pair(updated_records, Pair(report, EmptyList)) where report names the
+    removed source and its atoms with ContractFactLabel provenance; on
+    refusal the atoms are EmptyList. Removing a record removes every
+    flattened atom it carried, so a trie rebuilt from the returned chain
+    satisfies RelationContractMeets on the removed relation only if some
+    other record still supplies it. Unrelated records, unrelated facts,
+    rules, policies, and provenance are untouched.
+    """
+
+    def __init__(self, records, relation, source):
+        self.result = self._remove(records, relation, source)
+        super().__init__(
+            inputs=M.Pair(records, M.Pair(relation, M.Pair(source, EmptyList))),
+            results=self.result,
+        )
+
+    def _remove(self, records, relation, source):
+        from .proof import ContainsVar
+
+        refuse = M.Pair(
+            records,
+            M.Pair(
+                _contract_report(M.false_value, source, EmptyList),
+                EmptyList,
+            ),
+        )
+        if ContainsVar(relation)() is M.truth_value or ContainsVar(source)() is M.truth_value:
+            return refuse
+        existing = []
+        matched = []
+        walk = records
+        while IdentityCompare(walk, EmptyList)() is M.false_value:
+            if M.IsPair(walk)() is M.false_value:
+                return refuse
+            record = Head(walk)()
+            if _contract_record_well_formed(record) is M.false_value:
+                return refuse
+            existing.append(record)
+            walk = Tail(walk)()
+        for record in existing:
+            rec_source = Head(Tail(Tail(record)())())()
+            if M.Compare(rec_source, source)() is M.truth_value:
+                if _contract_record_declares(record, relation):
+                    if not _contract_value_in(matched, record):
+                        matched.append(record)
+        if len(matched) != 1:
+            return refuse
+        removed = matched[0]
+        kept = [r for r in existing if M.Compare(r, removed)() is M.false_value]
+        updated = _contract_chain_of(kept)
+        removed_atoms = Head(Tail(removed)())()
+        report = _contract_report(M.truth_value, source, removed_atoms)
+        return M.Pair(updated, M.Pair(report, EmptyList))
+
+    def __call__(self):
+        return self.result
+
+
