+    # S5: ablation: with the shell pack removed the goals fall back to
+    # silence (0 -> positive -> 0 for both)
+    runtime, packs = boot(shell_paths)
+    ra = probe(runtime, SHELL_GOAL_A, packs)
+    rb = probe(runtime, SHELL_GOAL_B, packs)
+    ok = ra["count"] == 0 and rb["count"] == 0
