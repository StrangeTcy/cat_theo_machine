+    arith_mappings = tuple(l for l in mapping_lines
+                           if "pack=arithmetic," in l)
+    shell_attributed = tuple(
+        rid for rid in ("nosolutions_introduction_characterization",
+                        "forall_implies_decomposition_characterization")
+        if any(("rule=%s," % rid) in l for l in rule_lines))
+    ok = (len(shell_mappings) == 5 and len(arith_mappings) == 1
+          and len(shell_attributed) == 2)
+    record("S8. surface audit: 5 shell mappings, both rules attributed", ok,
+           "shell mappings:\n   %s\narithmetic mappings: %d\n"
+           "rules attributed through the mapping: %s"
+           % ("\n   ".join(shell_mappings) or "none", len(arith_mappings),
+              ", ".join(shell_attributed) or "none"))
 
