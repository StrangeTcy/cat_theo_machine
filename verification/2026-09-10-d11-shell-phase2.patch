+           "A -> partial matches %d (cost %s)\nB -> partial matches %d (cost %s)"
+           % (ra["count"], ra["cost"], rb["count"], rb["cost"]))
+
+    # S6: nothing can discharge the capability premises: probing each
+    # capability term as a goal finds no candidate rule anywhere in the
+    # shipped packs, so the two shell rules can never fire and can never
+    # close a goal
+    runtime, packs = boot(PACK_PATHS)
+    cap_goal_a = "(" + SHELL_CAPABILITY_A + " positive-integers (unknowns x)" \
+                  + " (eq (plus x 1) x))"
+    cap_goal_b = "(" + SHELL_CAPABILITY_B + " n (greater n 1)" \
+                  + " (eq (plus a a) (plus a a)))"
+    r6a = probe(runtime, cap_goal_a, packs)
+    r6b = probe(runtime, cap_goal_b, packs)
+    ok = r6a["count"] == 0 and r6b["count"] == 0
+    record("S6. capability goals -> 0 partials (premises undischargeable)", ok,
+           "%s\n   -> partial matches %d (cost %s)\n"
+           "%s\n   -> partial matches %d (cost %s)"
+           % (cap_goal_a, r6a["count"], r6a["cost"],
+              cap_goal_b, r6b["count"], r6b["cost"]))
+
+    # S7: shell pack vocabulary: no FLT-specific words and no arithmetic
+    # constructor heads; the pack is pattern variables plus the five
+    # mapped shell/capability symbols only. 'nosolutions' here is the
+    # generic logical constructor named by the repair wave, not FLT
+    # vocabulary; the FLT-specific words are banned outright.
+    shell_path = os.path.join(os.path.dirname(PACK_PATHS[0]), SHELL_PACK_FILE)
+    shell_text = open(shell_path, encoding="utf-8").read().lower()
+    banned = ("fermat", "flt", "wiles", "frey", "pow", "times", "exponent",
+              "minus", "divides", "solutionmap")
+    word_hits = tuple(w for w in banned if w in shell_text)
+    import yaml as _yaml_shell
+    shell_doc = _yaml_shell.safe_load(open(shell_path, encoding="utf-8"))
+
+    syms_seen = set()
+
+    def _collect_syms(node):
+        if isinstance(node, list):
+            for item in node:
+                _collect_syms(item)
+            return
+        if not isinstance(node, dict):
+            return
+        if "sym" in node:
+            syms_seen.add(node["sym"])
+        for value in node.values():
+            _collect_syms(value)
+
+    _collect_syms(shell_doc.get("rules", []))
+    allowed = {"NoSolutionsLabel", "ForAllLabel", "ImpliesLabel",
+               "NeedContradictionFromArbitrarySolutionLabel",
+               "NeedBinderSafeImplicationLabel"}
+    ok = not word_hits and syms_seen == allowed
+    record("S7. shell pack: no FLT words, only the five mapped symbols", ok,
+           "word hits: %s\nconstructor symbols used: %s\nallowed: %s"
