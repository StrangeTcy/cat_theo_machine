+    runtime, packs = boot(shell_paths)
+    ra = probe(runtime, SHELL_GOAL_A, packs)
+    rb = probe(runtime, SHELL_GOAL_B, packs)
+    ok = ra["count"] == 0 and rb["count"] == 0
+    record("S1. shell pack absent -> Goal A 0 partials, Goal B 0 partials", ok,
+           "A %s\n   -> partial matches %d (cost %s)\n"
+           "B %s\n   -> partial matches %d (cost %s)"
+           % (SHELL_GOAL_A, ra["count"], ra["cost"],
+              SHELL_GOAL_B, rb["count"], rb["cost"]))
+
+    # S2: shipped state, Goal A: candidate partial, concrete capability
+    # premise in the residual, attributed to the shell pack, unclosed
+    runtime, packs = boot(PACK_PATHS)
+    ra = probe(runtime, SHELL_GOAL_A, packs)
+    concrete = tuple(t for t in ra["residuals"]
+                     if t.startswith("[" + SHELL_CAPABILITY_A + ","))
+    attributed = tuple(rid for rid in ra["rule_ids"]
+                       if rid.startswith(SHELL_PACK_NAME + "/"))
+    ok = (ra["count"] >= 1 and not ra["closed"]
+          and concrete and attributed)
+    record("S2. Goal A -> >=1 partial, concrete capability premise, unclosed",
+           ok,
+           "probe %s -> partial matches %d (cost %s)\nclosed: %s\n"
+           "rule ids: %s\nresiduals:\n   %s"
+           % (SHELL_GOAL_A, ra["count"], ra["cost"], ra["closed"],
+              ", ".join(ra["rule_ids"]) or "none",
+              "\n   ".join(ra["residuals"]) or "none"))
+
+    # S3: shipped state, Goal B, the same standard
+    rb = probe(runtime, SHELL_GOAL_B, packs)
+    concrete = tuple(t for t in rb["residuals"]
+                     if t.startswith("[" + SHELL_CAPABILITY_B + ","))
+    attributed = tuple(rid for rid in rb["rule_ids"]
+                       if rid.startswith(SHELL_PACK_NAME + "/"))
+    ok = (rb["count"] >= 1 and not rb["closed"]
+          and concrete and attributed)
+    record("S3. Goal B -> >=1 partial, concrete capability premise, unclosed",
+           ok,
+           "probe %s -> partial matches %d (cost %s)\nclosed: %s\n"
+           "rule ids: %s\nresiduals:\n   %s"
+           % (SHELL_GOAL_B, rb["count"], rb["cost"], rb["closed"],
+              ", ".join(rb["rule_ids"]) or "none",
+              "\n   ".join(rb["residuals"]) or "none"))
+
+    # S4: negative controls: shell heads no shipped rule concludes
+    rc1 = probe(runtime, SHELL_CONTROL_IMPLIES, packs)
+    rc2 = probe(runtime, SHELL_CONTROL_OVER, packs)
+    ok = rc1["count"] == 0 and rc2["count"] == 0
+    record("S4. negative controls (implies, over heads) -> 0 partials", ok,
+           "control %s\n   -> partial matches %d (cost %s)\n"
+           "control %s\n   -> partial matches %d (cost %s)"
