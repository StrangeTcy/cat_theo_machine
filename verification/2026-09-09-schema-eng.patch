+#!/usr/bin/env python3
+"""G-ENG artifact schema — machine-readable definitions, checker, doc generator.
+
+Single field-definition source (FIELD_DEFINITIONS below) for:
+  - the machine-readable schema (``--emit-schema``);
+  - the generated Markdown section embedded in
+    protocol/G-ENG-ARTIFACT-SCHEMA.md between the CUR-SCHEMA markers
+    (``--check-doc`` regenerates and diffs it — the drift test).
+
+The checker (``--check <bundle.json|bundle_dir>``) validates STRUCTURE
+ONLY: field presence, string/array/object shapes, enumerations, and
+declared numeric domains. It deliberately does NOT evaluate the pinned
+mathematical facts (kernel membership, descent bounds, residue
+arithmetic) — those belong to the extractor's checked handlers and the
+grader. Keeping these separate is the assignment's core requirement:
+
+  schema-valid                      -> this tool, exit 0
+  supported calculation checked     -> extractor handlers + grader
+  universal mathematical claim      -> NOT established by either
+  proof replayed                    -> NOT performed (tier 2.5 ceiling)
+  provenance/ablation by execution  -> only via real runs + digests
+
+Exit codes (aligned with the pipeline conventions):
+  0  bundle is schema-valid
+  2  bundle is malformed (structured error on stderr)
+  3  usage error / unreadable input
+
+Base: arena/01a066cf @ e72755a (extractor SCHEMA_VERSION 1).
+"""
+
+import json
+import os
+import sys
+
+SCHEMA_TAG = "geng-bundle/v2"
+DOC_PATH = os.path.join("protocol", "G-ENG-ARTIFACT-SCHEMA.md")
+DOC_BEGIN = "<!-- CUR-SCHEMA:GENERATED:BEGIN -->"
+DOC_END = "<!-- CUR-SCHEMA:GENERATED:END -->"
+
+CONTRACTS = ("E3", "E4", "E7")
+
+# Numeric domains are SHAPE constraints (type + range), not pinned math
+# facts: degree_bound<=3 as a *pinned fact* is C1's business; the schema
+# only constrains it to a sane integer domain.
+INT_DOMAINS = {
+    "degree_bound": (0, 10),
+    "houses": (1, 4),
+    "window_width": (2, 8),
+    "modulus": (2, 8),
+    "target_n": (3, 9),
+    "n": (1, 4096),
+    "lower_bound": (-16, 4096),
+    "residue": (-1024, 1024),
+}
+
+# role -> (contracts, payload fields with kinds). "alt" lists alternate
+# payload shapes; "moves_or_text" fields accept per-family shapes.
+FIELD_DEFINITIONS = {
+    "global": {
+        "schema_tag": SCHEMA_TAG,
+        "contracts": CONTRACTS,
+        "required_top": ("schema", "contract", "candidate", "nodes"),
+        "optional_top": ("claims", "records", "parameters"),
+        "candidate_fields": {"id": "str", "role": "str", "cites": "str_array", "text": "str_opt"},
+        "node_fields": {"id": "str", "role": "str", "kind": "enum:derived|assumption",
+                        "cites": "str_array_opt", "payload": "obj_opt", "text": "str_opt"},
+        "id_uniqueness_scope": "claims + candidate + nodes + records entries",
+    },
+    "roles": {
+        "weights":       ("E3", {"vector": "int_array", "provenance": "enum:derived|supplied"}),
+        "moves":         ("E3,E4", {"pairs": "pair_array_opt", "moves": "move_array_opt"}),
+        "start":         ("E3", {"vector": "int_array"}),
+        "odd-control":   ("E3,E7", {"target_n": "int:target_n_opt", "sample": "pm1_array_opt"}),
+        "generation":    ("E3", {"on_candidate": "int_array", "off_candidate": "int_array_opt"}),
+        "params":        ("E4,E7", {"houses": "int:houses_opt", "degree_bound": "int:degree_bound_opt",
+                                     "window_width": "int:window_width_opt", "modulus": "int:modulus_opt"}),
+        "hypothesis":    ("E4", {"houses": "int:houses_opt", "degree_bound": "int:degree_bound_opt"}),
+        "bound":         ("E4", {"lower_bound": "int:lower_bound_opt"}),
+        "wellfounded":   ("E4", {"lower_bound": "int:lower_bound_opt"}),
+        "terminal":      ("E4", {"claim": "enum:no_legal_move|global_min_opt"}),
+        "terminus":      ("E4", {"claim": "enum:no_legal_move|global_min_opt"}),
+        "measure":       ("E4,E7", {"provenance": "enum:derived|supplied"}),
+        "monovariant":   ("E4,E7", {"provenance": "enum:derived|supplied"}),
+        "samples":       ("E7", {"sequences": "pm1_matrix"}),
+        "separate":      ("E7", {"start_residue": "int:residue_opt", "target_residue": "int:residue_opt", "n": "int:n_opt"}),
+        "separation":    ("E7", {"start_residue": "int:residue_opt", "target_residue": "int:residue_opt", "n": "int:n_opt"}),
+        "control":       ("E7", {"sample": "pm1_array"}),
+        "rejected":      ("E7", {"candidates": "rejected_array"}),
+        "observable":    ("E7", {"provenance": "enum:derived|supplied"}),
+    },
+}
+
+
+class SchemaError(Exception):
+    pass
+
+
+def _check_kind(where, value, kind):
+    if kind.endswith("_opt"):
+        if value is None:
+            return
+        kind = kind[:-4]
+    if kind == "str":
+        if not isinstance(value, str) or not value:
+            raise SchemaError("%s: expected non-empty string" % where)
+    elif kind == "str_array":
+        if not isinstance(value, list) or any(not isinstance(x, str) or not x for x in value):
+            raise SchemaError("%s: expected array of non-empty strings" % where)
+    elif kind == "obj":
+        if not isinstance(value, dict):
+            raise SchemaError("%s: expected object" % where)
+    elif kind == "obj_opt":
+        if value is not None and not isinstance(value, dict):
+            raise SchemaError("%s: expected object or null" % where)
+    elif kind == "int_array":
+        if not isinstance(value, list) or not value or any(not isinstance(x, int) or isinstance(x, bool) for x in value):
+            raise SchemaError("%s: expected non-empty array of integers" % where)
+    elif kind == "pair_array":
+        if value is not None:
+            if not isinstance(value, list) or not value:
+                raise SchemaError("%s: expected non-empty array or null" % where)
+            for item in value:
+                if not isinstance(item, list) or len(item) != 2 or any(not isinstance(x, int) for x in item):
+                    raise SchemaError("%s: pairs items must be 2-integer arrays" % where)
+    elif kind == "move_array":
+        if value is not None:
+            if not isinstance(value, list) or not value:
+                raise SchemaError("%s: expected non-empty array or null" % where)
+            for item in value:
+                if not isinstance(item, dict):
+                    raise SchemaError("%s: moves items must be objects" % where)
+                has_e = ("e_in" in item) or ("e_out" in item)
+                has_d = ("d" in item) or ("s" in item)
+                if has_e and has_d:
+                    raise SchemaError(
+                        "%s: contradictory alternate move representations "
+                        "(e_in/e_out and d/s keys mixed in one record)" % where)
+                if not has_e and not has_d:
+                    raise SchemaError("%s: move record carries neither e_in/e_out nor d/s shape" % where)
+                for key in ("e_in", "e_out", "d", "s"):
+                    if key in item and (not isinstance(item[key], int) or isinstance(item[key], bool)):
+                        raise SchemaError("%s: move field %s must be an integer" % (where, key))
+    elif kind == "pm1_array":
+        if not isinstance(value, list) or not value or any(x not in (1, -1) for x in value):
+            raise SchemaError("%s: expected non-empty array of +1/-1" % where)
+    elif kind == "pm1_matrix":
+        if not isinstance(value, list) or not value:
+            raise SchemaError("%s: expected non-empty array of samples" % where)
+        for i, sample in enumerate(value):
+            _check_kind("%s[%d]" % (where, i), sample, "pm1_array")
+    elif kind == "rejected_array":
+        if not isinstance(value, list) or not value:
+            raise SchemaError("%s: expected non-empty array of rejected candidates" % where)
+        for i, item in enumerate(value):
+            if not isinstance(item, dict):
+                raise SchemaError("%s[%d]: expected object" % (where, i))
+            name = item.get("name")
+            klass = item.get("class")
+            if not isinstance(name, str) or not name:
+                raise SchemaError("%s[%d].name: expected non-empty string" % (where, i))
+            if klass not in ("not_invariant", "preserved_but_non_separating"):
+                raise SchemaError("%s[%d].class: expected a recognized rejection class" % (where, i))
+    elif kind.startswith("enum:"):
+        allowed = tuple(kind[5:].split("|"))
+        if value not in allowed:
+            raise SchemaError("%s: expected one of %s" % (where, "/".join(allowed)))
+    elif kind.startswith("int"):
+        if not isinstance(value, int) or isinstance(value, bool):
+            raise SchemaError("%s: expected an integer" % where)
+        name = kind[4:] if kind.startswith("int:") else ""
+        if name:
+            low, high = INT_DOMAINS[name]
+            if not (low <= value <= high):
+                raise SchemaError("%s: %s=%d outside declared domain [%d,%d]"
+                                  % (where, name, value, low, high))
+    else:
+        raise SchemaError("%s: unknown kind %s (definitions bug)" % (where, kind))
+
+
+def check_bundle(bundle):
+    """Validate one parsed bundle dict. Raises SchemaError with a reason."""
+    if not isinstance(bundle, dict):
+        raise SchemaError("bundle: expected a JSON object")
+    tag = bundle.get("schema")
+    if tag != SCHEMA_TAG:
+        raise SchemaError("schema: expected %r, got %r (incompatible schema version)"
+                          % (SCHEMA_TAG, tag))
+    contract = bundle.get("contract")
+    if contract not in CONTRACTS:
+        raise SchemaError("contract: expected one of %s, got %r" % ("/".join(CONTRACTS), contract))
+
+    candidate = bundle.get("candidate")
+    if not isinstance(candidate, dict):
+        raise SchemaError("candidate: expected an object")
+    for field, kind in FIELD_DEFINITIONS["global"]["candidate_fields"].items():
+        if field in candidate:
+            _check_kind("candidate.%s" % field, candidate[field], kind)
+    if not isinstance(candidate.get("id"), str) or not candidate["id"]:
+        raise SchemaError("candidate.id: expected non-empty string")
+
+    seen_ids = {}
+
+    def note_id(where, item_id):
+        if item_id in seen_ids:
+            raise SchemaError("duplicate id %r (%s and %s)" % (item_id, seen_ids[item_id], where))
+        seen_ids[item_id] = where
+
+    note_id("candidate", candidate.get("id"))
+
+    claims = bundle.get("claims", [])
+    if not isinstance(claims, list):
+        raise SchemaError("claims: expected an array")
+    for i, claim in enumerate(claims):
+        if not isinstance(claim, dict):
+            raise SchemaError("claims[%d]: expected an object" % i)
+        cid = claim.get("id")
+        if not isinstance(cid, str) or not cid:
+            raise SchemaError("claims[%d].id: expected non-empty string" % i)
+        note_id("claims[%d]" % i, cid)
+
+    nodes = bundle.get("nodes")
+    if not isinstance(nodes, list):
+        raise SchemaError("nodes: expected an array")
+    roles = FIELD_DEFINITIONS["roles"]
+    for i, node in enumerate(nodes):
+        where = "nodes[%d]" % i
+        if not isinstance(node, dict):
+            raise SchemaError("%s: expected an object" % where)
+        nid = node.get("id")
+        if not isinstance(nid, str) or not nid:
+            raise SchemaError("%s.id: expected non-empty string" % where)
+        note_id(where, nid)
+        role = node.get("role")
+        if not isinstance(role, str) or not role:
+            raise SchemaError("%s.role: expected non-empty string" % where)
+        if role in roles:
+            contracts, payload_fields = roles[role]
+            if contract not in contracts.split(","):
+                raise SchemaError("%s: role %r is not used by contract %s" % (where, role, contract))
+        for field, kind in FIELD_DEFINITIONS["global"]["node_fields"].items():
+            if field in node:
+                _check_kind("%s.%s" % (where, field), node[field], kind)
+        payload = node.get("payload")
+        if payload is not None:
+            if not isinstance(payload, dict):
+                raise SchemaError("%s.payload: expected an object" % where)
+            if role in roles:
+                _, payload_fields = roles[role]
+                for field, kind in payload_fields.items():
+                    if field in payload:
+                        _check_kind("%s.payload.%s" % (where, field), payload[field], kind)
+
+    records = bundle.get("records")
+    if records is not None:
+        if not isinstance(records, dict):
+            raise SchemaError("records: expected an object of arrays")
+        for name, entries in records.items():
+            if not isinstance(entries, list):
+                raise SchemaError("records.%s: expected an array" % name)
+            for i, entry in enumerate(entries):
+                where = "records.%s[%d]" % (name, i)
+                if not isinstance(entry, dict):
+                    raise SchemaError("%s: expected an object" % where)
+                eid = entry.get("id")
+                if not isinstance(eid, str) or not eid:
+                    raise SchemaError("%s.id: expected non-empty string" % where)
+                note_id(where, eid)
+                if "cites" in entry:
+                    _check_kind("%s.cites" % where, entry["cites"], "str_array")
+
+    parameters = bundle.get("parameters")
+    if parameters is not None and not isinstance(parameters, dict):
+        raise SchemaError("parameters: expected an object")
+    return True
+
+
+def emit_schema():
+    return json.dumps(FIELD_DEFINITIONS, indent=2, sort_keys=True)
+
+
+def generate_doc_section():
+    lines = []
+    lines.append(DOC_BEGIN)
+    lines.append("")
+    lines.append("## 9. Machine-readable schema (generated — do not edit by hand)")
+    lines.append("")
+    lines.append("Generated from the single field-definition source in")
+    lines.append("`tools/cur_artifact_schema.py` (`FIELD_DEFINITIONS`). Regenerate with")
+    lines.append("`python3 tools/cur_artifact_schema.py --check-doc` (fails on drift).")
+    lines.append("The checker validates STRUCTURE ONLY; the pinned mathematical facts")
+    lines.append("remain the checked handlers' and grader's business (section 0).")
+    lines.append("")
+    lines.append("```json")
+    lines.append(emit_schema())
+    lines.append("```")
+    lines.append("")
+    lines.append(DOC_END)
+    return "\n".join(lines)
+
+
+def check_doc(root):
+    path = os.path.join(root, DOC_PATH)
+    with open(path, "r", encoding="utf-8") as handle:
+        doc = handle.read()
+    if DOC_BEGIN not in doc or DOC_END not in doc:
+        return False, "documented schema section markers missing from " + DOC_PATH
+    start = doc.index(DOC_BEGIN)
+    end = doc.index(DOC_END) + len(DOC_END)
+    current = doc[start:end].rstrip("\n")
+    expected = generate_doc_section().rstrip("\n")
+    if current != expected:
+        return False, ("documented schema DRIFTED from the field definitions; "
+                       "regenerate the marked section in " + DOC_PATH)
+    return True, "documented schema matches the field definitions"
+
+
+def main(argv):
+    if len(argv) < 2:
+        sys.stderr.write("usage: cur_artifact_schema.py --check <bundle...> | --emit-schema | --check-doc\n")
+        return 3
+    if argv[1] == "--emit-schema":
+        print(emit_schema())
+        return 0
+    if argv[1] == "--check-doc":
+        ok, message = check_doc(os.getcwd())
+        print(("DOC-OK: " if ok else "DOC-DRIFT: ") + message)
+        return 0 if ok else 2
+    if argv[1] == "--check":
+        if len(argv) < 3:
+            sys.stderr.write("usage: cur_artifact_schema.py --check <bundle.json|bundle_dir>...\n")
+            return 3
+        failures = 0
+        for target in argv[2:]:
+            paths = []
+            if os.path.isdir(target):
+                for name in sorted(os.listdir(target)):
+                    if name.endswith(".json"):
+                        paths.append(os.path.join(target, name))
+            else:
+                paths.append(target)
+            for path in paths:
+                try:
+                    with open(path, "r", encoding="utf-8") as handle:
+                        bundle = json.load(handle)
+                    check_bundle(bundle)
+                    print("SCHEMA-VALID: %s" % path)
+                except SchemaError as error:
+                    failures += 1
+                    print("SCHEMA-INVALID: %s: %s" % (path, error))
+                except (OSError, ValueError) as error:
+                    failures += 1
+                    print("SCHEMA-INVALID: %s: unreadable (%s)" % (path, error))
+        return 0 if failures == 0 else 2
+    sys.stderr.write("unknown option %r\n" % argv[1])
+    return 3
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
