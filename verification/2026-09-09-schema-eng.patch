+#!/usr/bin/env python3
+"""cur_schema test suite — rejection cases, implementation coupling, drift.
+
+Three layers (per the SCHEMA-eng assignment):
+  1. REJECTION: malformed inputs must exit 2 — malformed collections,
+     duplicate identifiers, invalid numeric domains, contradictory
+     alternate move representations, incompatible schema versions,
+     unknown contracts, role/contract mismatches.
+  2. IMPLEMENTATION COUPLING: every existing extractor fixture
+     (tools/tests/cur_extractor/fixtures/) must be SCHEMA-VALID. The
+     definitions DESCRIBE the pinned implementation; a failure here is
+     a definitions bug (or a real mismatch to report with the fixture).
+  3. DRIFT: the generated section in protocol/G-ENG-ARTIFACT-SCHEMA.md
+     must match the field definitions exactly (--check-doc).
+
+Exit 0 only if every layer passes.
+"""
+
+import copy
+import json
+import os
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(os.path.dirname(os.path.dirname(HERE)))
+TOOL = os.path.join(ROOT, "tools", "cur_artifact_schema.py")
+FIXTURES = os.path.join(ROOT, "tools", "tests", "cur_extractor", "fixtures")
+
+PASS_BUNDLE = {
+    "schema": "geng-bundle/v2",
+    "contract": "E4",
+    "candidate": {"id": "cand", "role": "candidate", "cites": ["params", "moves"], "text": "t"},
+    "claims": [{"id": "cl1", "kind": "assumption", "text": "pinned"}],
+    "nodes": [
+        {"id": "params", "role": "params", "kind": "assumption", "cites": ["cl1"],
+         "payload": {"houses": 2, "degree_bound": 3}},
+        {"id": "moves", "role": "moves", "kind": "derived", "cites": ["cl1"],
+         "payload": {"moves": [{"e_in": 2, "e_out": 1}]}},
+    ],
+}
+
+
+def mutate(**changes):
+    bundle = copy.deepcopy(PASS_BUNDLE)
+    for path, value in changes.items():
+        node = bundle
+        keys = path.split(".")
+        for key in keys[:-1]:
+            node = node[int(key)] if key.isdigit() else node[key]
+        last = keys[-1]
+        if value is None:
+            node.pop(last, None)
+        else:
+            node[last] = value
+    return bundle
+
+
+REJECTIONS = {
+    "malformed-cites-nonarray": mutate(**{"nodes.0.cites": "cl1"}),
+    "malformed-payload-nonobject": mutate(**{"nodes.0.payload": [1, 2]}),
+    "malformed-nodes-nonarray": mutate(**{"nodes": {"id": "x"}}),
+    "duplicate-id": mutate(**{"nodes.1.id": "params"}),
+    "invalid-numeric-domain": mutate(**{"nodes.0.payload.degree_bound": 11}),
+    "invalid-numeric-type": mutate(**{"nodes.0.payload.houses": "two"}),
+    "contradictory-move-representation": mutate(
+        **{"nodes.1.payload.moves": [{"e_in": 2, "e_out": 1, "d": 4, "s": 2}]}),
+    "incompatible-schema-version": mutate(**{"schema": "geng-bundle/v1"}),
+    "unknown-contract": mutate(**{"contract": "E5"}),
+    "role-contract-mismatch": mutate(**{"contract": "E3"}),
+    "bad-provenance-enum": mutate(**{"nodes.1.payload.moves": None, "nodes.1.role": "measure",
+                                     "nodes.1.payload": {"provenance": "guessed"}}),
+    "bad-rejection-class": mutate(**{"contract": "E7", "nodes.1.role": "rejected",
+                                     "nodes.1.payload": {"candidates": [{"name": "x", "class": "invariant"}]}}),
+}
+
+EXPECT_VALID = {
+    "alt-move-ds-shape": mutate(**{"nodes.1.payload.moves": [{"d": 3, "s": 1}]}),
+    "optional-fields-absent": mutate(**{"claims": None, "nodes.0.cites": None}),
+}
+
+
+def run_checker(path):
+    proc = subprocess.run([sys.executable, TOOL, "--check", path],
+                          capture_output=True, text=True)
+    return proc.returncode, proc.stdout.strip()
+
+
+def main():
+    failures = []
+    work = tempfile.mkdtemp(prefix="cur-schema-test-")
+    print("== layer 1: rejection cases ==")
+    for name, bundle in REJECTIONS.items():
+        path = os.path.join(work, name + ".json")
+        with open(path, "w", encoding="utf-8") as handle:
+            json.dump(bundle, handle)
+        code, out = run_checker(path)
+        ok = code == 2
+        print("  %-38s exit=%d %s" % (name, code, "OK (rejected)" if ok else "FAIL (not rejected)"))
+        if not ok:
+            failures.append(name)
+    for name, bundle in EXPECT_VALID.items():
+        path = os.path.join(work, name + ".json")
+        with open(path, "w", encoding="utf-8") as handle:
+            json.dump(bundle, handle)
+        code, out = run_checker(path)
+        ok = code == 0
+        print("  %-38s exit=%d %s" % (name, code, "OK (valid)" if ok else "FAIL (rejected: " + out + ")"))
+        if not ok:
+            failures.append(name)
+
+    print("== layer 2: implementation coupling (existing fixtures) ==")
+    count = 0
+    for name in sorted(os.listdir(FIXTURES)):
+        if not name.endswith(".json"):
+            continue
+        count += 1
+        path = os.path.join(FIXTURES, name)
+        code, out = run_checker(path)
+        # the extractor's own negative fixtures must ALSO be rejected (the
+        # checker agreeing with the pinned implementation is the coupling)
+        expect_reject = name.startswith("malformed-") or name.startswith("unsupported-")
+        ok = (code == 2) if expect_reject else (code == 0)
+        want = "OK (rejected like the extractor)" if expect_reject else "OK"
+        print("  %-38s exit=%d %s" % (name[:-5], code, want if ok else "FAIL " + out))
+        if not ok:
+            failures.append("fixture:" + name)
+
+    print("== layer 3: documented-schema drift ==")
+    proc = subprocess.run([sys.executable, TOOL, "--check-doc"],
+                          capture_output=True, text=True, cwd=ROOT)
+    print("  check-doc exit=%d %s" % (proc.returncode, proc.stdout.strip()))
+    if proc.returncode != 0:
+        failures.append("doc-drift")
+
+    print()
+    print("checked: %d rejection/valid cases, %d existing fixtures, 1 drift check" %
+          (len(REJECTIONS) + len(EXPECT_VALID), count))
+    if failures:
+        print("FAILURES: %s" % ", ".join(failures))
+        return 1
+    print("ALL LAYERS PASS")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
